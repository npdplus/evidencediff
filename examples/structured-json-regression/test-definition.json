{
  "version": 1,
  "id": "structured-json-regression",
  "name": "Structured JSON regression",
  "description": "Candidate changes a required approved decision to manual-review.",
  "baseline": {
    "path": "baseline.json",
    "contentType": "json",
    "label": "Approved baseline"
  },
  "candidate": {
    "path": "candidate.json",
